<?xml version="1.0" encoding="utf-8"?>
<!--
  贴传 · Windows 托盘助手 —— MSIX 包清单（Microsoft Store 分发）

  占位符（由 scripts\build-msix.ps1 替换后才可打包）：
    __IDENTITY_NAME__  包标识名。本地测试用 ailinkfree.PengchuanTray；
                       上架时替换为 Partner Center 为该应用保留的名称。
    __PUBLISHER__      证书 Subject。必须与签名证书 Subject 完全一致，
                       否则 makeappx / Store 校验会报签名与清单不符。
                       本地测试用自签名证书的 Subject；
                       上架时替换为 Partner Center 身份页里的 Publisher（形如 CN=<GUID>）。
    __VERSION__        四段式版本号，如 0.1.3.0（MSIX 不接受三段）。

  必须与证书一致这一点是最容易踩的坑，改 Publisher 时务必同步换签名证书。
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 desktop desktop2 rescap">

  <Identity
      Name="__IDENTITY_NAME__"
      Publisher="__PUBLISHER__"
      Version="__VERSION__"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>贴传</DisplayName>
    <PublisherDisplayName>ailinkfree</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>手机与电脑局域网直传：手机碰 NFC 标签后，电脑自动接收文件</Description>
  </Properties>

  <Dependencies>
    <!-- 19041 = Windows 10 2004；同时满足 Win10 与 Win11 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <!-- EntryPoint 用 Windows.FullTrustApplication：这是打包 Win32/桌面应用的固定写法，
         配合 rescap:runFullTrust 能力，进程拥有完整用户权限（可访问文件系统、托盘、网络）。 -->
    <Application Id="PengchuanTray" Executable="PengchuanTray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="贴传"
          Description="手机与电脑局域网直传：手机碰 NFC 标签后，电脑自动接收文件"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png"
            ShortName="贴传" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1976D2" />
      </uap:VisualElements>

      <Extensions>
        <!--
          登录自启：替代免安装版里的 schtasks 计划任务。
          官方限制（必须知道，会影响 UX 设计）：
            1. 用户必须手动启动过本应用至少一次，该 startupTask 才会注册；
            2. 用户可在任务管理器「启动」标签里自行禁用；
            3. 一旦用户禁用，程序无法用代码强行重新启用。
          注意：startupTask 属于「应用级」扩展，必须放在 <Application><Extensions> 下。
        -->
        <desktop:Extension
            Category="windows.startupTask"
            Executable="PengchuanTray.exe"
            EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
              TaskId="PengchuanTrayStartup"
              Enabled="true"
              DisplayName="贴传助手" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 桌面（Win32）打包应用的必需受限能力；Store 提交时会被要求说明理由 -->
    <rescap:Capability Name="runFullTrust" />
    <!-- 打开公网取件页 / 调用云端接口 -->
    <Capability Name="internetClient" />
    <!-- 访问局域网内的手机临时服务 -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

  <!--
    防火墙例外：mDNS 发现依赖 UDP 5353 收发（见 MdnsClient.cs 的多播实现）。
    Profile 限定 private，只对「专用网络」放行，比全放行更安全。

    注意：firewallRules 属于「**包级**」扩展，makeappx 明确要求它出现在
    <Package><Extensions> 下；放到 <Application><Extensions> 会报
    "should be declared under <Package> extensions" 并导致打包失败。
  -->
  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="PengchuanTray.exe">
        <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="5353" LocalPortMax="5353" Profile="private" />
        <desktop2:Rule Direction="out" IPProtocol="UDP" Profile="private" />
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="private" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
