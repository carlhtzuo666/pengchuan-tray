<Project Sdk="Microsoft.NET.Sdk">

  <!--
    贴传 · Windows 托盘助手（T1，绿色单文件）
    目标：不装接收端服务、不监听任何端口；只在托盘点一下/或检测到手机就绪时：
      · 自动用浏览器打开手机的局域网页（局域网直连，零云成本）
      · 或直接把手机「发件箱」里的文件下载到桌面
    找不到手机（不同网络）时打开账号取件页 https://share.ailinkfree.com
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PengchuanTray</RootNamespace>
    <AssemblyName>PengchuanTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 签名/版本元数据：SignPath 要求产物带一致的产品名与版本属性 -->
    <Product>贴传助手</Product>
    <AssemblyTitle>贴传助手</AssemblyTitle>
    <Company>ailinkfree</Company>
    <Description>贴传 · 电脑端托盘助手：检测到手机就绪即自动打开局域网页或接收文件</Description>
    <Copyright>Copyright (c) 2026 ailinkfree</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <RepositoryUrl>https://github.com/carlhtzuo666/pengchuan-tray</RepositoryUrl>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <FileVersion>0.1.3.0</FileVersion>
    <InformationalVersion>0.1.3</InformationalVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!--
      自解压原生库保持 true：实测设为 false 会让 WinForms 在 EnableVisualStyles
      阶段取不到程序清单（Assembly.Location 为空 → FileStream 打开失败），
      托盘助手 GUI 直接启动崩溃。功能可用优先于「少解一个 %TEMP% 目录」这项
      弱化的杀软启发式特征——真正的解法是 Authenticode 签名。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 无第三方依赖：mDNS 用自建 MdnsClient（Makaretu.Dns.Multicast 在 .NET 10 上收不到应答，见 MdnsClient.cs 注释） -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
